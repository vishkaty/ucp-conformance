{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://spck.dev/schemas/known_issues.schema.json",
 "title": "spck.dev KNOWN ISSUES (single path: conformance/ci/known_issues.json; PLAN-v3 \u00a72.13, D5-07)",
 "type": "object",
 "required": [
  "generated",
  "spec_pin",
  "issues"
 ],
 "additionalProperties": false,
 "properties": {
  "_about": {
   "type": "string"
  },
  "generated": {
   "type": "string",
   "format": "date"
  },
  "spec_pin": {
   "const": "cd78fb38e819de77d9b527d110476eccb876f1bd"
  },
  "issues": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "artifact",
     "component",
     "symptom",
     "repro",
     "status_by_cut",
     "origin",
     "re_verified",
     "confidence",
     "ledger_row",
     "review_by",
     "refuted"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^KI-[0-9]{3}$"
     },
     "artifact": {
      "enum": [
       "ucp-spec",
       "ucp-schema",
       "python-sdk",
       "js-sdk",
       "samples-python",
       "samples-node",
       "official-conformance",
       "golden-0825",
       "spck-conformance"
      ]
     },
     "component": {
      "type": "string",
      "minLength": 1
     },
     "symptom": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
     },
     "repro": {
      "type": "object",
      "required": [
       "command",
       "expected",
       "observed"
      ],
      "additionalProperties": false,
      "properties": {
       "command": {
        "type": "string",
        "minLength": 1
       },
       "expected": {
        "type": "string",
        "minLength": 1
       },
       "observed": {
        "type": "string",
        "minLength": 1
       }
      }
     },
     "status_by_cut": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "required": [
        "cut",
        "status"
       ],
       "additionalProperties": false,
       "properties": {
        "cut": {
         "type": "string",
         "minLength": 1
        },
        "status": {
         "enum": [
          "open",
          "fixed",
          "not-applicable"
         ]
        },
        "evidence": {
         "type": "string",
         "minLength": 1
        }
       },
       "if": {
        "properties": {
         "status": {
          "const": "fixed"
         }
        }
       },
       "then": {
        "required": [
         "evidence"
        ]
       }
      }
     },
     "origin": {
      "enum": [
       "ours",
       "theirs",
       "shared"
      ]
     },
     "filed": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^https://github.com/"
      }
     },
     "re_verified": {
      "type": "string",
      "format": "date"
     },
     "confidence": {
      "enum": [
       "high",
       "medium",
       "low"
      ]
     },
     "ledger_row": {
      "type": "string",
      "pattern": "^[GRS][0-9]+[a-e]?$"
     },
     "review_by": {
      "type": "string",
      "format": "date"
     },
     "refuted": {
      "const": false
     }
    }
   }
  }
 }
}
