# golden-0825 build/runtime artifacts -- not vendored sources, just local state
# from `uv sync` / `pytest` runs. The dependency pins that matter (ucp-sdk==0.5.0,
# see server/pyproject.toml) are committed; the resolved virtualenv is not.
server/.venv/
server/.pytest_cache/
smoke/.pytest_cache/
.pytest_cache/

# R11 battery run report -- a generated artifact (validate_golden_0825_battery.py
# writes it every run for run_suite.py's report-only line), not a source file.
battery/LAST_RUN.json
